parameters:
	ignoreErrors:
		-
			message: '#^Call to function is_array\(\) with array will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: app/Core/LazyLoad.php

		-
			message: '#^Instanceof between \*NEVER\* and Traversable will always evaluate to false\.$#'
			identifier: instanceof.alwaysFalse
			count: 1
			path: app/Core/LazyLoad.php

		-
			message: '#^Instanceof between App\\Models\\Model and App\\Models\\Model will always evaluate to true\.$#'
			identifier: instanceof.alwaysTrue
			count: 1
			path: app/Core/LazyLoad.php

		-
			message: '#^Instanceof between Traversable\<mixed, mixed\> and Traversable will always evaluate to true\.$#'
			identifier: instanceof.alwaysTrue
			count: 1
			path: app/Core/LazyLoad.php

		-
			message: '#^Parameter \#1 \$array \(non\-empty\-list\<mixed\>\) of array_values is already a list, call has no effect\.$#'
			identifier: arrayValues.list
			count: 1
			path: app/Core/LazyLoad.php

		-
			message: '#^Result of \|\| is always false\.$#'
			identifier: booleanOr.alwaysFalse
			count: 1
			path: app/Core/LazyLoad.php

		-
			message: '#^Strict comparison using \=\=\= between array and false will always evaluate to false\.$#'
