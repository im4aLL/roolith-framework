{
    "name": "roolith/framework",
    "description": "Roolith PHP framework",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Md Habibullah Al Hadi",
            "email": "me@habibhadi.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "roolith/cache": "^2.0",
        "roolith/config": "^2.0",
        "roolith/database": "2.0.0",
        "roolith/event": "^2.0",
        "roolith/generator": "^2.0",
        "roolith/router": "^2.1",
        "roolith/template-engine": "^1.1",
        "nesbot/carbon": "2.73.0",
        "filp/whoops": "^2.18",
        "psr/log": "^3.0",
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "archive": {
        "exclude": [
            "installer.zip",
            ".github",
            "documentation",
            "tests"
        ]
    },
    "scripts": {
        "test": "phpunit --colors=always"
    }
}
