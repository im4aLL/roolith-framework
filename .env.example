# Copy to .env and adjust. Advanced options default automatically, see config/config.md.
# APP_ENV accepts any value (production, staging, uat, development, ...).
# Only exactly `development` enables verbose errors; everything else boots production-safe.
# Unset APP_ENV defaults to production (fail-closed).
APP_ENV=production
APP_URL=http://localhost:8080/
VITE_DEV_SERVER=

# Database: leave DB_HOST empty to run without a database (database => null).
DB_HOST=
DB_NAME=
DB_USER=
DB_PASS=

# Set to 0 to force www instead of non-www.
FORCE_NON_WWW=1

# Optional static version string. Unset means a per-boot timestamp (dev-friendly, no cache).
APP_VERSION=

# Optional log file path. Unset defaults to APP_ROOT/storage/logs/app.log.
# Allowed: non-empty path without null bytes or `..` segments; `\` normalized to `/`.
# Relative paths resolve against APP_ROOT.
# LOG_PATH=

# Routine logs are off by default. Unset keeps debug/info/notice dropped;
# warning and above are always written. Set to true to restore info lines.
# LOG_ENABLED=true

# Cookie hardening: path defaults to /, domain empty means host-only.
# COOKIE_PATH=/
# COOKIE_DOMAIN=
# Secure defaults to 1 on https APP_URL and 0 on plain http; override here.
# COOKIE_SECURE=
# SameSite defaults to Lax (allowed: Lax, Strict, None). None requires COOKIE_SECURE=1.
# COOKIE_SAMESITE=Lax
# Session lifetime in seconds, 0 means until the browser closes.
# SESSION_LIFETIME=0

# Comma-separated proxy IPs allowed to set forwarded-IP headers.
# Empty (default) means proxy headers are never trusted. Exact IP match only (CIDR not supported).
# TRUSTED_PROXIES=

# Baseline security headers on/off (default on).
# SECURITY_HEADERS=1

# Advanced keys (logPath, cookie*, sessionLifetime, trustedProxies, securityHeaders)
# are optional in config/config.php and default in code. See config/config.md.
